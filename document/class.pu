' 現在の実装。3図をまとめて描画: plantuml -tsvg -o ../target/class-diagram document/class.pu
@startuml class_modules
title モジュール構成（2026-11-16・実装済み）
top to bottom direction
skinparam shadowing false
skinparam defaultFontName "SansSerif"
skinparam packageStyle rectangle
skinparam componentStyle rectangle

component "main.rs\nCLI / PlayingGame\nウィンドウ・音声デバイスの寿命" as Main
component "model/\nconfig : Lua定義と検証\nentity : 個体・所持品・負傷\nmap : 配置索引\ncombat : ダイス・戦闘計算" as Model
component "game/\nmod : Game / Panel / Event・ターン進行\nactions : Actionの適用\nworld : 配置・検索・攻撃・スナップショット\nplayer / enemies : 行動\ncrafting / progression : 制作・成長\nequipment / statistics : 装備・能力計算\nitem_actions / interactions / containers\nnutrition / treatment / mental / visibility" as Game
component "ui/\nmod : GameState::tick\ninput / direction_input : 入力 → Action\nrender / camera : 描画・ズーム\ninspect / targeting : 調査・照準\nfooting / properties / quick_slots\nanimations / melee : 攻撃キュー・踏み込み\ngame_over : 終了画面\njapanese / theme : 文字・UI配色" as UI
component "scripting.rs\nLuaRuntime / Action / Effect / ScriptResult\nLua読込・実行・Rustとの境界" as Script
component "media/\ntextures / textures::variants\n画像検査・登録・接続形状・描画接続\nsound : Sound / SoundPlayer" as Media

Main --> Game : 起動・ヘッドレス実行
Main --> UI : tick
Main --> Media : 素材・音声の初期化
UI <--> Game : 入力・表示 / 画面状態・演出
Game <--> Script : 呼出・結果適用 / snapshot・敵行動型
Game <--> Model : 世界操作 / CraftJob・Progression型
Script --> Model : 定義・ID・位置
UI --> Model : 個体・表示値
UI --> Media : テクスチャ描画・音イベント
Game <--> Media : 表示資源・音キュー / impl Game
Media --> Model : 位置・定義の検証

note bottom of Game
  フォルダは責務ごとの配置。独立したサービスや一方向の層ではない。
  多くのファイルは同じ Game の impl を分担する。
  制作・装備・操作・成長には画面処理も残る。
  model の個体も game の CraftJob / Progression 型を参照する。
  Gameの責務集中・相互依存の解消は今後の分離対象。
end note
legend bottom
  矢印 = 主要なコード依存（全use文の列挙ではない）
  lib.rs は5モジュールを公開。旧ルートパスは再公開で互換性を保持。
  src/assets/ は同梱フォント素材で、Rustモジュールではない。
endlegend
@enduml

@startuml class_runtime
title 実行・状態所有・Entity（主要フィールドのみ）
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty methods

class PlayingGame <<main>> {
  game: Game
  audio: Option<SoundPlayer>
  tick(ctx)
}
interface "bracket_lib::GameState" as GameState {
  tick(ctx)
}
class Game <<game>> {
  player_id: EntityId
  entities: BTreeMap<Id, Entity>
  map: Map
  recipes: Vec<Recipe>
  crafting_rules: CraftRules
  growth_rules: GrowthRules
  mental_rules: MentalRules
  entity_definitions: Arc<BTreeMap<String, Definition>>
  scripts: Rc<LuaRuntime>
  pending_action: Option<Action>
  events: VecDeque<Event>
  panel: Panel
  animations: VecDeque<Animation>
  animation_batch: u64
  motion_console: Option<usize>
  sounds: VecDeque<Sound>
  texture_renderer: Option<Arc<TextureRenderer>>
  rng / disease_rng / growth_rng: Rng
  running: bool
  game_over: bool
  turn: u64
  load(root)
  input(ctx)
  update_frame(elapsed_ms)
  update()
  advance_turn()
  render(ctx)
}
enum Panel <<game>> {
  World / Inventory / Properties / Map
  Crafting / Container / Bandage / Equipment
  Inspect / Targeting / ItemTarget / ItemDetails
  InteractionDirection / InteractionMenu
  OpenDirection / OpenMenu
}
enum Entity <<model::entity>> {
  Movable(MoveEntity)
  Static(StaticEntity)
  Item(ItemEntity)
}
class MoveEntity <<model::entity>> {
  id: EntityId
  position: Pos
  script: ScriptBinding
  hp: HP
  body: BTreeMap<String, InjuryStage>
  treatment: Box<WoundTreatment>
  hydration: Meter
  stamina / max_stamina: u32
  sanity / max_sanity: u32
  ghoul: bool
  kinryoku / subayasa / kiyousa / seishinryoku: u32
  nutrition: Nutrition
  skill: Box<Skill>
  progression: Box<Progression>
  inventory: Box<Inventory>
  crafting: Option<CraftJob>
}
class StaticEntity <<model::entity>> {
  id: EntityId
  position: Pos
  script: ScriptBinding
  role: StaticRole
  facilities: Vec<FacilityKind>
  resources: Vec<ResourceAmount>
  taikyudo: u32
}
class ItemEntity <<model::entity>> {
  id: EntityId
  location: ItemLocation
  script: ScriptBinding
  quantity: u32
  quality: i32
  loaded_ammo: u32
  contents: Vec<ContainerEntry>
}
class Inventory <<model::entity>> {
  items: Vec<EntityId>
  right_hand / left_hand: Option<EntityId>
  equipped: Option<EntityId>
  armor: BTreeMap<String, EntityId>
  quick_slots: [Option<QuickSlot>; 10]
}
enum ItemLocation <<model::entity>> {
  Ground(Pos)
  CarriedBy(EntityId)
}
class Map <<model::map>> {
  width / height / depth: i32
  cells: Vec<Cell>
}
class Cell <<model::map>> {
  entity_ids: Vec<EntityId>
}
class Progression <<game::progression>> {
  level: u32
  experience: u64
  practice: BTreeMap<SkillKind, u32>
  last_damage_source: Option<EntityId>
}
class SoundPlayer <<media::sound>>
class TextureRenderer <<media::textures>>
class Animation <<ui::animations>>
class MeleeMotion <<ui::melee>> {
  actor: Box<Entity>
  target: Pos
  offset(origin, elapsed_ms)
}

PlayingGame ..|> GameState
Game ..|> GameState
PlayingGame *-- Game
PlayingGame *-- SoundPlayer
Game *-- Entity
Game *-- Map
Game *-- Panel
Game *-- Animation
Animation *-- MeleeMotion
MeleeMotion *-- Entity : 表示用スナップショット
Game o-- TextureRenderer : Arc共有
Entity *-- MoveEntity
Entity *-- StaticEntity
Entity *-- ItemEntity
MoveEntity *-- Inventory
MoveEntity *-- Progression
Inventory --> Entity : 所持・装備ID参照
ItemEntity *-- ItemLocation
Map *-- Cell
Cell --> Entity : 配置ID参照

note bottom of Game
  PlayingGame.tick → Game.tick
  input → update_frame（演出更新＋update）→ render
  同じ世界ターン内の演出は敏捷降順、同値は発生順。
  判定順は従来どおり、表示・音だけこの順に再生する。
  tick後に音イベントを取り出して再生する。
  描画・音の再生は戦闘結果を再適用しない。
  HP死亡は所持品・成長を保って復帰する。
  正気度0はグール化してgame_over=true / running=false。
  終了画面の入力だけを受け付け、世界の更新・復帰を停止する。
end note
note bottom of Map
  位置の正本はEntity、MapはIDだけの索引。
  生成・移動・所持・消費・削除はRustの共通処理で整合を保つ。
  独立して世界を所有するWorld型はない。
end note
@enduml

@startuml class_rules
title Lua定義・効果適用・制作（現在の実装）
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty methods

class Game <<game>> {
  recipes: Vec<Recipe>
  entity_definitions: Arc<BTreeMap<String, Definition>>
  scripts: Rc<LuaRuntime>
  events()
  advance_turn()
}
class LuaRuntime <<scripting>> {
  definitions: Arc<BTreeMap<String, Definition>>
  load(root)
  call(world, id, hook, event): Result<ScriptResult>
}
class ScriptResult <<scripting>> {
  state: Option<Value>
  effects: Vec<Effect>
  action: Option<Action>
}
enum Action <<scripting>>
enum Effect <<scripting>>
class WorldSnapshot <<game::world>> {
  entity_definitions: Arc<BTreeMap<String, Definition>>
  entities: BTreeMap<Id, Entity>
  map: Map
  view(): EntityView
}
class EntityView <<game::world>>
class ScriptBinding <<model::entity>> {
  definition_id: String
  state: Value
  glyph: Option<String>
}
class Definition <<model::config>> {
  id: String
  category: String
  common: Common
  movable: Option<MovableDefinition>
  static: Option<StaticDefinition>
  item: Option<ItemDefinition>
  initial_state: Value
  interactions: Vec<InteractionDefinition>
  validate()
}
class MovableDefinition <<model::config>> {
  experience_reward: u32
  skills: Skill
  controls: BTreeMap<String, Binding>
}
class StaticDefinition <<model::config>> {
  movement_cost: f32
  facilities: Vec<FacilityKind>
}
class ItemDefinition <<model::config>> {
  weapon: Option<Weapon>
  armor: Option<Armor>
  tool_functions: Vec<ItemProp>
  tool_levels: BTreeMap<ItemProp, u32>
  contents: Vec<ContainerEntry>
}
class Recipe <<game::crafting>> {
  id: String
  ingredients / outputs: Vec<ItemAmount>
  required_tools: Vec<ToolRequirement>
  required_facilities: Vec<FacilityKind>
  required_skills: Vec<SkillRequirement>
  resource_costs: Vec<ResourceAmount>
  work_turns: u32
  quality_enabled: bool
}
class CraftJob <<game::crafting>> {
  recipe: String
  completed_turns: u32
  selected_ingredients: Vec<ItemSelection>
  selected_tools: Vec<ToolSelection>
  selected_facilities: Vec<Id>
  selected_resources: Vec<ResourceSelection>
  success_rate: u32
  quality_modifier: i32
}
enum Supply <<game::crafting>> {
  Item(Id)
  Stored(container: Id, index: usize)
}
class MoveEntity <<model::entity>> {
  crafting: Option<CraftJob>
}

Game o-- LuaRuntime : Rc共有
Game o-- Definition : Arc共有
LuaRuntime o-- Definition : Arc共有
LuaRuntime ..> WorldSnapshot : 読み取り用ctx
WorldSnapshot ..> EntityView : 借用ビュー
LuaRuntime ..> ScriptResult : 結果を返す
ScriptResult *-- Action
ScriptResult *-- Effect
Game ..> ScriptResult : 検証・適用・失敗時に巻き戻し
ScriptBinding --> Definition : definition_id
Definition *-- MovableDefinition
Definition *-- StaticDefinition
Definition *-- ItemDefinition
Game *-- Recipe
MoveEntity *-- CraftJob
CraftJob --> Recipe : recipe ID
CraftJob --> Supply : 材料・工具の選択

note bottom of Definition
  categoryに対応する定義を一種類だけ許可する。
  能力・行動・レシピ・調整値はLua、整合性を守る共通操作はRust。
  DefinitionData / EntityDefinitionという別のRust型はない。
end note
note bottom of CraftJob
  所持品・足元と周囲8マス・届く収納を参照。
  工具レベルは必須、技能は成功率・出来へ反映。
  完了時に一括消費・生成。入る分は所持、残りは足元。
  資源メーター・炉・金床などは未実装。
  詳細・初期案は document/production/ を参照。
end note
@enduml
